# Zippy – copy to .env and fill in (never commit .env)

# Frontend (optional – in frontend/.env.local)
# Set to "true" only when using the 21st.dev browser extension; avoids WebSocket reconnection errors when extension is not connected.
# NEXT_PUBLIC_21ST_TOOLBAR=

# Backend (create backend/.env or set in environment)
# Generate a key with: openssl rand -hex 32
SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collections_autopilot
FRONTEND_URL=http://localhost:3000

# Auth
JWT_EXPIRE_MINUTES=10080
TOKENIZED_LINK_EXPIRE_HOURS=168

# QuickBooks (optional; use mock if not set)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/settings/integrations
QUICKBOOKS_ENVIRONMENT=sandbox

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Collections Autopilot <onboarding@resend.dev>
REPLY_TO=

# SMS (Twilio, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage (S3 or local)
S3_BUCKET=dispute-uploads
LOCAL_UPLOAD_PATH=./uploads

# Scheduler
SCHEDULER_RUN_REMINDERS_EVERY_SECONDS=60
